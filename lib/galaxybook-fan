#!/bin/bash
# =============================================================================
# galaxybook-fan - the installed fix's command (installed by install.sh as
# /usr/local/sbin/galaxybook-fan; by the packages as /usr/bin/galaxybook-fan)
#
#   galaxybook-fan status         what's installed, and the fan speed now
#   sudo galaxybook-fan check     will it work on this laptop? (read-only)
#   sudo galaxybook-fan rebuild   after a BIOS update: read the new firmware
#                                 and build the module again
#   sudo galaxybook-fan test-native
#                                 can the stock acpi-fan driver read the fan
#                                 by itself now? (then the fix isn't needed)
#   sudo galaxybook-fan update    install the newest release's package
#   sudo galaxybook-fan updates on|off
#                                 "new version" notifications on or off
#   galaxybook-fan updates status are they on? (checked hourly)
#   galaxybook-fan updates check  look now; if there's a new version, show
#                                 the notification (no sudo)
#
# 'galaxybook-fan --help' shows the same as a table (cmd_help).
# =============================================================================
set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Next to this script when installed; ../lib's copy when run from a clone
for d in "$HERE" /usr/lib/galaxybook-fan /usr/local/lib/samsung-galaxybook/fan; do
    [[ -f "$d/fanpaths.sh" ]] && { LIBDIR="$d"; break; }
done
[[ -n "${LIBDIR:-}" ]] || { echo "galaxybook-fan: fanpaths.sh not found - is the fix installed?" >&2; exit 2; }
# shellcheck source=fanpaths.sh
source "$LIBDIR/fanpaths.sh"
# shellcheck source=fan-dkms.sh
source "$LIBDIR/fan-dkms.sh"
# shellcheck source=update.sh
[[ -f "$LIBDIR/update.sh" ]] && source "$LIBDIR/update.sh"
GBFAN_HERE="$LIBDIR"        # notify-update.sh beside this command (or a clone's lib/)

# Installed copies, or the clone's when run from lib/ before installing
MONITOR_SCRIPT="$CHECK_SCRIPT"
[[ -x "$MONITOR_SCRIPT" ]] || MONITOR_SCRIPT="$LIBDIR/samsung-galaxybook-fan-check.sh"
LAPTOP_CHECK="$LIBDIR/check-galaxybook-fan.sh"
[[ -f "$LAPTOP_CHECK" ]] || LAPTOP_CHECK="$LIBDIR/../tools/check-galaxybook-fan.sh"

if [[ -t 1 ]]; then
    B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else
    B=""; G=""; Y=""; R=""; C=""; N=""
fi
ok()   { echo "${G}[ OK ]${N}  $*"; }
info() { echo "${C}[INFO]${N}  $*"; }
warn() { echo "${Y}[WARN]${N}  $*"; }
fail() { echo "${R}[FAIL]${N}  $*"; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || { echo "Run it with sudo: sudo galaxybook-fan $1"; exit 2; }; }

state_value() { sed -n "s/^$1=//p" "$STATE_FILE" 2>/dev/null | tail -1; }
fan_rpm() {
    local h
    for h in /sys/class/hwmon/hwmon*; do
        [[ "$(cat "$h/name" 2>/dev/null)" == "$MOD_NAME" ]] && { cat "$h/fan1_input" 2>/dev/null; return; }
    done
    return 1
}
uninstall_hint() {
    if [[ "$(state_value INSTALL_METHOD)" == package ]] || gbfan_package_installed; then
        echo "remove the galaxybook-fan package (e.g. sudo dnf remove galaxybook-fan, sudo apt remove galaxybook-fan or sudo pacman -R galaxybook-fan)"
    else
        echo "run 'sudo ./uninstall.sh' in ${INSTALL_DIR:-$(state_value INSTALL_DIR)}"
    fi
}

cmd_status() {
    local v kernels rpm method dir rec_k rec_b
    v="$(gbfan_dkms_version || true)"
    method="$(state_value INSTALL_METHOD)"; dir="$(state_value INSTALL_DIR)"
    rec_k="$(state_value KVER)"; rec_b="$(state_value BIOS)"
    echo "${B}galaxybook-fan${N}"
    if [[ -z "$v" ]]; then
        warn "Not registered with DKMS - the fix isn't installed."
        exit 1
    fi
    kernels="$(gbfan_dkms_kernels "$v" | tr '\n' ' ')"
    info "Version ${v}, built for: ${kernels:-no kernel yet}"
    if [[ "$method" == package ]]; then info "Installed from the galaxybook-fan package"
    else info "Installed with install.sh${dir:+ from ${dir}}"; fi
    if [[ -d /sys/module/$MOD_NAME ]]; then
        if rpm="$(fan_rpm)"; then ok "Module loaded - fan: ${rpm} RPM"
        else warn "Module loaded, but its fan sensor isn't there"; fi
    else
        warn "Module not loaded on kernel $(uname -r)"
        [[ "$(cat /sys/class/dmi/id/bios_version 2>/dev/null)" != "$rec_b" && -n "$rec_b" ]] \
            && info "The BIOS changed since the last check ($rec_b) - run: sudo galaxybook-fan rebuild"
    fi
    [[ -n "$rec_k" ]] && info "Last checked at login: kernel ${rec_k}, BIOS ${rec_b}"
    declare -F gbfan_latest_version >/dev/null && cmd_updates status
    exit 0
}

cmd_check() {
    need_root check
    [[ -f "$LAPTOP_CHECK" ]] || fail "check-galaxybook-fan.sh not found (looked in ${LIBDIR} and ../tools)"
    exec bash "$LAPTOP_CHECK"
}

cmd_rebuild() {
    need_root rebuild
    local v k kernels=() failed=0 built=0 reason rpm hcmd
    v="$(gbfan_dkms_version)" || fail "galaxybook-fan isn't registered with DKMS - install it first"
    # The running kernel, plus every other kernel it's built for that still has headers
    kernels+=("$(uname -r)")
    while read -r k; do
        [[ -n "$k" && "$k" != "$(uname -r)" && -d /lib/modules/$k/build ]] && kernels+=("$k")
    done < <(gbfan_dkms_kernels "$v")

    trap gbfan_dkms_resume_initramfs EXIT
    gbfan_dkms_defer_initramfs
    gbfan_unload || true
    for k in "${kernels[@]}"; do
        info "Building galaxybook-fan ${v} for ${k} from this machine's firmware"
        if ! gbfan_has_headers "$k"; then
            warn "The kernel headers for ${k} aren't installed, so it can't be built."
            hcmd="$(gbfan_headers_cmd "$k")"
            [[ -n "$hcmd" ]] && warn "  Install them, then run this again: ${hcmd}"
            failed=1
            continue
        fi
        if gbfan_dkms_rebuild_kernel "$v" "$k" >/tmp/galaxybook-fan-rebuild.log 2>&1; then
            ok "Built and installed for ${k}"
            built=1
        else
            reason="$(gbfan_dkms_build_reason "$v" || true)"
            warn "Build for ${k} failed${reason:+: ${reason#galaxybook-fan: }}"
            [[ -z "$reason" ]] && warn "  see /tmp/galaxybook-fan-rebuild.log"
            failed=1
        fi
    done

    if modprobe "$MOD_NAME" 2>/dev/null; then
        # Ours reads the fan again: take it from acpi-fan (the unbind service
        # skipped itself at boot while the module couldn't load)
        systemctl restart "$UNBIND_SVC" >/dev/null 2>&1 || true
        gbfan_unbind_acpi_fan || true
        sleep 1
        rpm="$(fan_rpm || true)"
        ok "Module loaded${rpm:+ - fan: ${rpm} RPM}"
        bash "$MONITOR_SCRIPT" --record-state "$(state_value INSTALL_DIR)" "$(state_value INSTALL_METHOD)" \
            || warn "Couldn't record the new state"
    else
        [[ $built -eq 1 ]] && warn "The module didn't load - see: sudo dmesg | grep galaxybook_fan"
        # Give the fan back to the stock driver meanwhile (it may work here)
        systemctl stop "$UNBIND_SVC" >/dev/null 2>&1 || true
        gbfan_bind_acpi_fan
        failed=1
    fi
    exit $failed
}

cmd_test_native() {
    need_root test-native
    if [[ -d /sys/module/$MOD_NAME ]]; then
        info "The test needs the fan spinning - waiting up to 2 minutes."
        info "If it's quiet, load the CPU in another terminal, e.g.: timeout 180 openssl speed -multi \$(nproc) rsa4096"
    fi
    case "$(bash "$MONITOR_SCRIPT" --test-native --wait 120)" in
        works)     ok "The stock driver reads the fan speed - this fix is no longer needed: $(uninstall_hint)" ;;
        broken)    ok "The stock driver still can't read the fan speed - keep this fix" ;;
        fan-off)   warn "The fan wasn't spinning, so the test proved nothing - load the CPU and try again" ;;
        no-device) warn "No ACPI fan device or acpi-fan driver found" ;;
        *)         fail "The native test failed to run" ;;
    esac
}

# Download the newest release's package for this system, check it against the
# release's SHA256SUMS, and install it with the system's package manager
# (which asks before installing, as usual)
cmd_update() {
    need_root update
    local cur latest fmt pattern name dir rc
    declare -F gbfan_latest_version >/dev/null || fail "update.sh is missing - reinstall galaxybook-fan"
    cur="$(gbfan_installed_version)" \
        || fail "Can't tell which version is installed - is galaxybook-fan installed? ('galaxybook-fan status')"
    latest="$(gbfan_latest_version)" \
        || fail "Couldn't find the newest release on GitHub (no network, or the repository isn't public yet)"
    if ! gbfan_version_newer "$cur" "$latest"; then
        ok "galaxybook-fan ${cur} is up to date (newest release: ${latest})"
        exit 0
    fi
    info "galaxybook-fan ${latest} is available (you have ${cur}): $(gbfan_release_url "$latest")"

    fmt="$(gbfan_package_format)"
    if [[ -z "$fmt" ]]; then
        info "This copy was installed with install.sh, so update it the same way:"
        info "  $(gbfan_update_hint)"
        exit 0
    fi
    pattern="$(gbfan_package_pattern "$latest" "$fmt")"

    # World-readable folder: apt reads the file as its own _apt user
    dir="$(mktemp -d)" || fail "mktemp failed"
    chmod 755 "$dir"
    trap 'rm -rf "$dir"' EXIT
    curl -fsSL --max-time 60 -o "$dir/SHA256SUMS" \
        "$GBFAN_REPO_URL/releases/download/v${latest}/SHA256SUMS" \
        || fail "Couldn't download the release's SHA256SUMS (if ${latest} has only just been released, its files may not be attached yet: try again in a few minutes)"
    name="$(awk '{print $2}' "$dir/SHA256SUMS" | sed 's/^\*//' | grep -E "$pattern" | sort -V | tail -1)"
    [[ -n "$name" ]] || fail "The ${latest} release has no ${fmt} package"
    info "Downloading ${name}"
    curl -fsSL --max-time 300 -o "$dir/$name" "$GBFAN_REPO_URL/releases/download/v${latest}/${name}" \
        || fail "Couldn't download ${name}"
    ( cd "$dir" && grep -E "[[:space:]]\*?${name//./\\.}\$" SHA256SUMS | sha256sum -c --quiet - ) >/dev/null 2>&1 \
        || fail "${name} doesn't match the release's SHA256SUMS - not installed"
    ok "Checksum matches the release's SHA256SUMS"
    chmod 644 "$dir/$name"

    case "$fmt" in
        rpm)  dnf install "$dir/$name" ;;
        deb)  apt install "$dir/$name" ;;
        arch) pacman -U "$dir/$name" ;;
    esac
    rc=$?
    [[ $rc -eq 0 ]] && ok "galaxybook-fan ${latest} installed - 'galaxybook-fan status' shows it"
    exit $rc
}

cmd_updates() {
    case "${1:-status}" in
        off) need_root "updates off"
             mkdir -p "$GBFAN_ETC" && touch "$UPDATES_OFF" \
                 && ok "No more \"new version\" notifications. Turn them back on: sudo galaxybook-fan updates on" ;;
        on)  need_root "updates on"
             rm -f "$UPDATES_OFF"; rmdir "$GBFAN_ETC" 2>/dev/null || true
             ok "\"New version\" notifications are on: GitHub asked hourly and at login, told once per version" ;;
        status)
             # The command to change it on a line of its own: in brackets after
             # "on" it read as if they were off
             if [[ -e "$UPDATES_OFF" ]]; then
                 info "\"New version\" notifications: off"
                 echo "        To turn them on: sudo galaxybook-fan updates on"
             else
                 info "\"New version\" notifications: on (GitHub checked at login and hourly)"
                 echo "        To turn them off: sudo galaxybook-fan updates off"
             fi ;;
        check)
             # As the user: a notification sent as root wouldn't reach their desktop
             [[ $EUID -ne 0 ]] || fail "Run it without sudo, so the notification reaches your desktop: galaxybook-fan updates check"
             local cur latest
             cur="$(gbfan_installed_version)" || fail "Can't tell which version is installed - is galaxybook-fan installed?"
             latest="$(gbfan_latest_version)" \
                 || fail "Couldn't find the newest release on GitHub (no network?)"
             if ! gbfan_version_newer "$cur" "$latest"; then
                 ok "galaxybook-fan ${cur} is up to date (newest release: ${latest})"
                 return 0
             fi
             if ! gbfan_release_ready "$latest"; then
                 info "galaxybook-fan ${latest} is being released - its files aren't attached yet, try again in a few minutes"
                 return 0
             fi
             info "galaxybook-fan ${latest} is available (you have ${cur}): $(gbfan_release_url "$latest")"
             info "To update, run: $(gbfan_update_hint)"
             if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] \
                     && gbfan_update_notify "$cur" "$latest" "galaxybook-fan-notify-check-$$"; then
                 gbfan_update_mark_told "$latest"
                 info "Notification shown (with Update now / What's new where your desktop has buttons)"
             fi ;;
        *)   echo "Usage: galaxybook-fan updates on|off|status|check" >&2; exit 2 ;;
    esac
}

# --help: the commands as a table, 80 columns wide; commands in bold on a
# terminal. Each row is "command|what it does"; the description wraps inside
# its cell.
cmd_help() {
    local w1=35 w2=38 row cmd desc part first i
    local rows=(
        "galaxybook-fan status|What's installed, and the fan speed now"
        "sudo galaxybook-fan check|Will it work on this laptop? (read-only)"
        "sudo galaxybook-fan rebuild|After a BIOS update: read the new firmware and build the module again"
        "sudo galaxybook-fan test-native|Can the stock acpi-fan driver read the fan by itself now? (then the fix isn't needed)"
        "sudo galaxybook-fan update|Install the newest release's package"
        "sudo galaxybook-fan updates on/off|\"New version\" notifications on or off"
        "galaxybook-fan updates status|Are they on? (checked hourly)"
        "galaxybook-fan updates check|Look now; if there's a new version, show the notification (no sudo)"
    )
    rule() {
        local a b
        a="$(printf '─%.0s' $(seq $((w1 + 2))))"; b="$(printf '─%.0s' $(seq $((w2 + 2))))"
        echo "$1$a$2$b$3"
    }
    echo "${B}galaxybook-fan${N} - fan speed fix for the Samsung Galaxy Book 5"
    echo "Installed as /usr/bin/galaxybook-fan by the packages,"
    echo "or /usr/local/sbin/galaxybook-fan by install.sh"
    echo
    rule ┌ ┬ ┐
    printf '│ %s%-*s%s │ %s%-*s%s │\n' "$B" "$w1" "Command" "$N" "$B" "$w2" "What it does" "$N"
    rule ├ ┼ ┤
    for i in "${!rows[@]}"; do
        row="${rows[$i]}"; cmd="${row%%|*}"; desc="${row#*|}"
        cmd="${cmd//on\/off/on|off}"
        first=1
        while IFS= read -r part; do
            part="${part%"${part##*[! ]}"}"          # fold leaves a trailing space
            if (( first )); then
                printf '│ %s%-*s%s │ %-*s │\n' "$B" "$w1" "$cmd" "$N" "$w2" "$part"; first=0
            else
                printf '│ %-*s │ %-*s │\n' "$w1" "" "$w2" "$part"
            fi
        done < <(fold -s -w "$w2" <<<"$desc")
        (( i < ${#rows[@]} - 1 )) && rule ├ ┼ ┤
    done
    rule └ ┴ ┘
}

case "${1:-}" in
    status)      cmd_status ;;
    update)      cmd_update ;;
    updates)     cmd_updates "${2:-}" ;;
    check)       cmd_check ;;
    rebuild)     cmd_rebuild ;;
    test-native) cmd_test_native ;;
    -h|--help|help|"") cmd_help; [[ -n "${1:-}" ]]; exit $? ;;
    *) echo "Unknown command: $1 (see galaxybook-fan --help)" >&2; exit 2 ;;
esac
