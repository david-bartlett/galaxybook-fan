# Maintainer: David Bartlett <22402006+david-bartlett@users.noreply.github.com>
#
# galaxybook-fan for Arch and Arch-based distros (CachyOS, EndeavourOS, …)
#
#   cd packaging/arch && makepkg -si
#
# Packages the repository this file is in (its working tree, so local changes
# are included). VERSION is read from the repository. Architecture-independent:
# the package ships the module's source and DKMS builds it on the laptop, with
# its config made from this laptop's DSDT (module/gen-config.sh).

_repo="$(cd "$startdir/../.." && pwd)"
pkgname=galaxybook-fan
pkgver=$(tr -d '[:space:]' < "$_repo/VERSION")
pkgrel=1
pkgdesc="Fan speed for the Samsung Galaxy Book 5 (DKMS module)"
arch=('any')
url="https://github.com/david-bartlett/galaxybook-fan"
license=('GPL-2.0-only')
depends=('dkms' 'make' 'gcc' 'acpica' 'python' 'kmod' 'bash' 'systemd' 'polkit' 'libnotify')
optdepends=('linux-headers: to build the module for the linux kernel (or your kernel'"'"'s -headers package, e.g. linux-cachyos-headers)')
# Config files, as rpm %config(noreplace) and deb conffiles: kept if changed
backup=('etc/modules-load.d/galaxybook_fan.conf' 'etc/xdg/autostart/galaxybook-fan-session.desktop')
install=galaxybook-fan.install

# The files are shared with the rpm and deb (packaging/install-files.sh).
package() {
    bash "$_repo/packaging/install-files.sh" "$pkgdir"
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" "$_repo/README.md" "$_repo/CHANGELOG.md"
    install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
