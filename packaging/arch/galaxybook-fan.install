# galaxybook-fan - pacman install scripts (run as root, never interactive)
#
# What the rpm and deb do after installing and before removing is in
# /usr/lib/galaxybook-fan/package-scripts.sh, shared by all three formats.
#
# pacman ignores these scripts' exit status, so they can't stop an install:
# - Galaxy Book 5 only: module/gen-config.sh refuses to build the module on
#   anything else (the reason is printed here); GALAXYBOOK_FAN_FORCE=1 builds
#   anyway, as with the rpm and deb.
# - A copy installed with install.sh shares files with this package, so pacman
#   stops before these scripts with "exists in filesystem": run
#   'sudo ./uninstall.sh' from its folder first.
# Arch's own DKMS hooks also build the module for every installed kernel with
# headers, and remove it, around these scripts.

_gbfan=/usr/lib/galaxybook-fan

_configure() {
    if [ "${GALAXYBOOK_FAN_FORCE:-0}" = 1 ]; then
        mkdir -p /etc/galaxybook-fan && touch /etc/galaxybook-fan/force
    fi
    # Kernel headers: each Arch kernel package names itself in its module folder
    # (linux, linux-lts, linux-cachyos, …); its headers are <that>-headers
    _k=$(uname -r)
    if [ ! -e "/usr/lib/modules/$_k/build" ]; then
        _base=$(cat "/usr/lib/modules/$_k/pkgbase" 2>/dev/null || echo linux)
        echo "==> galaxybook-fan: the headers for the running kernel ($_k) aren't installed."
        echo "    Install them and DKMS builds the module automatically:"
        echo "      sudo pacman -S ${_base}-headers"
    fi
    bash "$_gbfan/package-scripts.sh" configure 2>&1 | sed 's/^/==> /' || true
}

post_install() {
    _configure
    # Only reached if pacman wasn't stopped by shared files (an older copy)
    if [ -e /usr/local/sbin/galaxybook-fan ] || [ -e /usr/local/bin/samsung-galaxybook-fan-check.sh ] \
            || [ -e /etc/systemd/system/galaxybook-acpi-fan-unbind.service ]; then
        echo "==> WARNING: a copy of galaxybook-fan installed with install.sh is still here."
        echo "    Remove the package, remove that copy from its folder, then install the package again:"
        echo "      sudo pacman -R galaxybook-fan && sudo ./uninstall.sh"
    fi
}

post_upgrade() {
    _configure
}

pre_remove() {
    bash "$_gbfan/package-scripts.sh" remove 2>&1 | sed 's/^/==> /' || true
}

post_remove() {
    systemctl daemon-reload 2>/dev/null || true
}
