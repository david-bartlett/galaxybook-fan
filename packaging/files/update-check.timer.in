# Written by @WRITTEN_BY@.
[Unit]
Description=galaxybook-fan - look for a new release (30 s after login, then hourly; GitHub at most once a day)
# PartOf stops the timer at logout so it re-arms on the next login.
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=30s
AccuracySec=1s
OnCalendar=hourly
Unit=@UPDATE_CHECK_SVC@

[Install]
WantedBy=graphical-session.target
