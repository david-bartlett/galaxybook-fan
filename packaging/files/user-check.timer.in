[Unit]
Description=Samsung Galaxy Book — fan speed fix login check (10s after login, then daily)
# PartOf stops the timer at logout so it re-arms on the next login.
PartOf=graphical-session.target
After=graphical-session.target
DefaultDependencies=no

[Timer]
OnActiveSec=10
AccuracySec=1s
# Also daily, for sessions that last for days (suspend, not log out): the
# check does nothing unless something changed, and looks for a new release
# at most once a day
OnCalendar=daily
Unit=@USER_CHECK_SVC@

[Install]
WantedBy=graphical-session.target
