[Unit]
Description=Samsung Galaxy Book — fan speed fix login check (10s after login)
# PartOf stops the timer at logout so it re-arms on the next login.
PartOf=graphical-session.target
After=graphical-session.target
DefaultDependencies=no
# Not for system accounts: the login screen's own session (gdm, sddm) is a
# user session too, and with the packages' "systemctl --global enable" this
# would run there, before anyone has logged in.
ConditionUser=!@system

[Timer]
OnActiveSec=10
AccuracySec=1s
Unit=@USER_CHECK_SVC@

[Install]
WantedBy=graphical-session.target
